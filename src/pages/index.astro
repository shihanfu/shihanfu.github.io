---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers } from '../lib/papers';
import news from '../data/news.json';

const cvUrl = '/assets/papers/CV_Shihan_Fu.pdf';

const contacts = [
  { label: 'Email', href: 'mailto:fu.shiha@northeastern.edu' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=KznoaAEAAAAJ' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/shihan-fu-5b0b88259/' },
  { label: 'GitHub', href: 'https://github.com/shihanfu' },
  { label: 'ORCID', href: 'https://orcid.org/0009-0005-3019-6600' },
  { label: 'CV', href: cvUrl, primary: true },
];

// Line icons from Lucide (ISC license)
const contactCards = [
  {
    label: 'Email',
    value: 'fu.shiha@northeastern.edu',
    href: 'mailto:fu.shiha@northeastern.edu',
    icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    label: 'Google Scholar',
    value: 'Shihan Fu',
    href: 'https://scholar.google.com/citations?user=KznoaAEAAAAJ',
    icon: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
  },
  {
    label: 'LinkedIn',
    value: 'shihan-fu',
    href: 'https://www.linkedin.com/in/shihan-fu-5b0b88259/',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'X (Twitter)',
    value: '@shihan1420876',
    href: 'https://x.com/shihan1420876',
    icon: '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  },
];

const featured = papers.filter((p) => p.featured);
---

<Base title="Shihan Fu">
  <Header />

  <!-- Intro Section Start -->
  <section id="about" class="intro">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-4 col-md-4">
          <img class="intro-photo" src="/assets/img/about/shihan.JPG" alt="Photo of Shihan with Link from the legend of Zelda" />
        </div>
        <div class="col-lg-8 col-md-8">
          <h1 class="intro-title">Hi, I'm Shihan!<br />I design AI that supports people through complex tasks.</h1>
          <p class="intro-text">
            I'm a CS Ph.D. student at <a href="https://www.northeastern.edu">Northeastern University</a>, building AI systems
            that provide situated support across health, learning, and everyday decision-making.
            Previously, I received my Master's in <a href="https://cma.hkust-gz.edu.cn">Computational Media and Arts</a> at HKUST.
          </p>
          <div class="intro-links">
            {contacts.map((c) => (
              <a class={`pill${c.primary ? ' pill-solid' : ''}`} href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'}>{c.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- News Section Start -->
  <section id="news" class="news">
    <div class="container">
      <h2 class="news-heading">News</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <span class="news-date">{item.date}</span>
            <span class="news-text"><Fragment set:html={item.html} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Research Section Start -->
  <section id="research" class="research">
    <div class="container">
      <div class="research-head">
        <h2 class="research-heading">Selected Research</h2>
        <a class="pill" href="/research">All {papers.length} papers →</a>
      </div>
      {featured.map((paper) => <PaperCard paper={paper} />)}
      <div class="research-more">
        <a class="pill pill-solid" href="/research">View all {papers.length} papers →</a>
        <span>{papers.length - featured.length} more on health, learning, and human-AI interaction</span>
      </div>
    </div>
  </section>

  <!-- Contact Section Start -->
  <section id="contact" class="contact">
    <div class="container">
      <h2 class="contact-heading">Contacts</h2>
      <div class="contact-grid">
        {contactCards.map((c) => (
          <a class="contact-card" href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'}>
            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={c.icon} />
            <span class="contact-label">{c.label}</span>
            <span class="contact-value">{c.value}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .intro {
    padding: 60px 0 80px;
  }

  .intro-photo {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
  }

  .intro-title {
    font-size: clamp(32px, 3.6vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #333;
    margin: 0 0 28px;
  }

  .intro-text {
    font-size: 18px;
    line-height: 1.65;
    color: #555;
    max-width: 560px;
    margin-bottom: 32px;
  }

  .intro-text a,
  .news-text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #55748A;
    text-underline-offset: 4px;
  }

  .intro-text a:hover,
  .news-text :global(a:hover) {
    color: #55748A;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .news {
    padding: 40px 0 90px;
  }

  .news-heading {
    font-size: 28px;
    margin-bottom: 20px;
  }

  .news-list li {
    display: flex;
    gap: 32px;
    padding: 18px 0;
    border-top: 1px solid #e2ddd6;
  }

  .news-list li:last-child {
    border-bottom: 1px solid #e2ddd6;
  }

  .news-date {
    flex: 0 0 90px;
    font-size: 15px;
    color: #55748A;
  }

  .news-text {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
  }

  .research {
    padding: 40px 0 80px;
  }

  .research-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .research-heading {
    font-size: 28px;
    margin: 0;
  }

  .research-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    padding-top: 32px;
    border-top: 1px solid #e2ddd6;
  }

  .research-more span {
    font-size: 15px;
    color: #555;
  }

  .contact {
    padding: 40px 0 100px;
  }

  .contact-heading {
    font-size: 28px;
    margin-bottom: 28px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: #fbfaf8;
    border: 1px solid #d6d1ca;
    border-radius: 20px;
    transition: border-color 0.2s;
  }

  .contact-card:hover {
    border-color: #333;
  }

  .contact-icon {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: #555;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 24px;
  }

  .contact-label {
    font-size: 18px;
    color: #333;
    margin-bottom: 10px;
  }

  .contact-value {
    align-self: flex-start;
    max-width: 100%;
    font-size: 15px;
    color: #555;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: #55748A;
    text-underline-offset: 4px;
  }

  .contact-card:hover .contact-value {
    color: #55748A;
  }

  @media (max-width: 991px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Keep the contact pills on one line on smaller laptop screens */
  @media (min-width: 768px) and (max-width: 1199px) {
    .intro-links {
      gap: 6px;
    }

    .intro-links .pill {
      padding: 7px 13px;
      font-size: 14px;
    }
  }

  @media (max-width: 767px) {
    .intro {
      padding: 30px 0 50px;
    }

    .intro-photo {
      max-width: 280px;
      margin-bottom: 32px;
    }

    .news-list li {
      flex-direction: column;
      gap: 4px;
    }

    .news-date {
      flex-basis: auto;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
