---
import { type Paper, authorsHtml, categoryTags, paperLinks, youtubeId } from '../lib/papers';

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;
const { pdfUrl, linkLabel } = paperLinks(paper);
const detailUrl = `/research/${paper.slug}`;
---

<div class="paper-item" data-category={paper.category}>
  <article class="paper">
    <a class="paper-media" href={detailUrl}>
      <img src={`/assets/papers/${paper.image}`} alt={paper.imageAlt} loading="lazy" />
    </a>
    <div class="paper-body">
      <div class="paper-head">
        <h3 class="paper-title"><a href={detailUrl}>{paper.title}</a></h3>
        <span class="paper-tag">{categoryTags[paper.category]}</span>
      </div>
      <p class="paper-authors"><Fragment set:html={authorsHtml(paper)} />{paper.note && <> <i>{paper.note}</i></>}</p>
      <p class="paper-venue">{paper.venue}</p>
      {paper.award && <p class="paper-award">{paper.award}</p>}
      <div class="paper-actions">
        <a class="pill pill-solid" href={detailUrl}>Details</a>
        {pdfUrl && <a class="pill" href={pdfUrl} target="_blank">PDF ↗︎</a>}
        {paper.url && <a class="pill" href={paper.url} target="_blank">{linkLabel} ↗︎</a>}
        {youtubeId(paper.video) ? (
          <a class="pill" href={`${detailUrl}#video`}>Video</a>
        ) : (
          paper.video && <a class="pill" href={paper.video} target="_blank">Video ↗︎</a>
        )}
      </div>
    </div>
  </article>
</div>

<style>
  .paper {
    display: flex;
    gap: 32px;
    padding: 28px 0;
  }

  .paper-media {
    flex: 0 0 48%;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
  }

  .paper-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .paper-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .paper-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 12px;
  }

  .paper-title {
    flex: 1;
    font-size: 20px;
    line-height: 1.35;
    margin: 0;
  }

  .paper-title a {
    color: #333;
  }

  .paper-title a:hover {
    color: #55748A;
  }

  .paper-tag {
    flex-shrink: 0;
    font-size: 14px;
    color: #555;
  }

  .paper-authors,
  .paper-venue {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
  }

  .paper-venue {
    margin-top: 8px;
  }

  .paper-award {
    margin-top: 8px;
    font-size: 14px;
    color: #55748A;
  }

  .paper-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 20px;
  }

  @media (max-width: 767px) {
    .paper {
      flex-direction: column;
      gap: 20px;
    }

    .paper-media {
      flex-basis: auto;
    }
  }
</style>
