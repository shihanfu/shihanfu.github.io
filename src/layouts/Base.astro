---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VFLKS4M83F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VFLKS4M83F');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts - DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/responsive.css" />
    <style is:global>
      /* Cross-page transitions: the header stays put while the content fades and rises in */
      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root) {
        animation: 160ms ease-in both page-fade-out;
      }

      ::view-transition-new(root) {
        animation: 380ms cubic-bezier(0.2, 0.7, 0.2, 1) 60ms both page-fade-in;
      }

      @keyframes page-fade-out {
        to {
          opacity: 0;
        }
      }

      @keyframes page-fade-in {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }

      /* Keep anchored sections clear of the sticky header */
      section[id] {
        scroll-margin-top: 80px;
      }

      @media (max-width: 767px) {
        section[id] {
          scroll-margin-top: 110px;
        }
      }

      /* Lighter headings to match DM Sans styling */
      h1, h2, h3, h4, .section-title {
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      /* Pill buttons: outline by default, solid dark for the primary action */
      .pill {
        display: inline-block;
        padding: 9px 18px;
        font-size: 15px;
        line-height: 1.4;
        color: #555;
        border: 1px solid #c8c8c8;
        border-radius: 500px;
      }

      .pill:hover {
        color: #333;
        border-color: #333;
      }

      .pill-solid,
      .pill-solid:hover {
        color: #fff;
        background: #333;
        border-color: #333;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
