---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VFLKS4M83F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VFLKS4M83F');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>{title}</title>
    <link rel="icon" href="/assets/img/icon.png" />

    <!-- Google Fonts - Raleway -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/fonts/font-awesome.min.css" />
    <link rel="stylesheet" href="/assets/fonts/simple-line-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/assets/css/slicknav.css" />
    <link rel="stylesheet" href="/assets/css/nivo-lightbox.css" />
    <link rel="stylesheet" href="/assets/css/animate.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/responsive.css" />
    <style is:global>
      .icon-social-linkedin:before {
        content: "\e60a" !important;
        font-family: 'Simple-Line-Icons' !important;
      }

      /* Clickable card styles */
      .clickable-card {
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .clickable-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      }

      .clickable-card .btn {
        position: relative;
        z-index: 10;
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script is:inline src="/assets/js/jquery-min.js"></script>
    <script is:inline src="/assets/js/popper.min.js"></script>
    <script is:inline src="/assets/js/bootstrap.min.js"></script>
    <script is:inline src="/assets/js/jquery.mixitup.js"></script>
    <script is:inline src="/assets/js/jquery.counterup.min.js"></script>
    <script is:inline src="/assets/js/waypoints.min.js"></script>
    <script is:inline src="/assets/js/wow.js"></script>
    <script is:inline src="/assets/js/jquery.nav.js"></script>
    <script is:inline src="/assets/js/jquery.easing.min.js"></script>
    <script is:inline src="/assets/js/nivo-lightbox.js"></script>
    <script is:inline src="/assets/js/jquery.slicknav.js"></script>
    <script is:inline src="/assets/js/main.js"></script>

    <!-- Clickable card functionality -->
    <script is:inline>
      document.querySelectorAll('.clickable-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var link = this.getAttribute('data-link');
          if (link) {
            window.open(link, '_blank');
          }
        });
      });
    </script>
  </body>
</html>
